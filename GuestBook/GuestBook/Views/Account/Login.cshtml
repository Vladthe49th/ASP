@model GuestBook.ViewModels.LoginViewModel

<h2>Вхід</h2>

<form asp-action="Login" method="post">
    <div class="mb-3">
        <label asp-for="Login"></label>
        <input asp-for="Login" class="form-control" />
        <span asp-validation-for="Login" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <span class="text-danger">@Html.ValidationSummary()</span>

    <button type="submit" class="btn btn-primary">Увійти</button>
    <a asp-action="Register" class="btn btn-secondary">Реєстрація</a>
    <a asp-action="GuestLogin" class="btn btn-outline-dark">Увійти як гість</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
