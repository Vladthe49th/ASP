@model GuestBook.ViewModels.IndexViewModel

@{
    ViewData["Title"] = "Гостьова книга";
}

<h2>Гостьова книга</h2>

@if (Model.IsAuthenticated)
{
    <div class="alert alert-info">
        Вітаємо, <strong>@Model.CurrentUserLogin</strong>!
    </div>

    <form asp-action="AddMessage" method="post" class="mb-4">
        <div class="mb-3">
            <textarea name="Text"
                  class="form-control"
                  rows="4"
                  placeholder="Залиште ваш запис у гостьовій книзі..."
                  required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">
            ✍️ Додати запис
        </button>
    </form>
}
else
{
    <div class="alert alert-warning">
        Щоб залишити повідомлення,
        <a asp-controller="Account" asp-action="Login">увійдіть</a>
        або
        <a asp-controller="Account" asp-action="Register">зареєструйтесь</a>.
    </div>
}

<hr />

@if (!Model.Messages.Any())
{
    <p>Повідомлень поки що немає.</p>
}
else
{
    <div class="guestbook-container">

        @foreach (var message in Model.Messages)
        {
            <div class="message-card mb-3 p-3 border rounded shadow-sm">
                <div class="d-flex justify-content-between mb-2">
                    <strong>@message.User.Login</strong>
                    <span class="text-muted">
                        @message.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </span>
                </div>

                <div>
                    @message.Text
                </div>
            </div>
        }

    </div>
}
