<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GuestBook</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GuestBook.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    GuestBook
                </a>

                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="Account" asp-action="Login">
                        Вхід
                    </a>
                    <a class="nav-link" asp-controller="Account" asp-action="Register">
                        Реєстрація
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="navbar-nav ms-auto">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <span class="nav-link">Привіт, @User.Identity.Name!</span>
            <a class="nav-link" asp-controller="Account" asp-action="Logout">
                Вихід
            </a>
        }
        else
        {
            <a class="nav-link" asp-controller="Account" asp-action="Login">
                Вхід
            </a>
            <a class="nav-link" asp-controller="Account" asp-action="Register">
                Реєстрація
            </a>
        }
    </div>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GuestBook - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
